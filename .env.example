# 复制为 .env 并填入真实值（.env 已被 gitignore）。已有环境变量优先于本文件。
# 基准评测 fusion 臂的 OpenAI 兼容嵌入端点（缺省智谱 embedding-3）。

AGENT_RETRIEVAL_EMBEDDING_API_KEY=
# AGENT_RETRIEVAL_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas
# AGENT_RETRIEVAL_EMBEDDING_MODEL=embedding-3
# AGENT_RETRIEVAL_EMBEDDING_DIMENSIONS=1024

# —— rerank 臂（--arm rerank，可选）：Cohere 风格 /rerank 端点 ——————————
# 缺省指向 SiliconFlow 的 BAAI/bge-reranker-v2-m3（免费额度即可跑）；
# Jina / Cohere 等同格式端点改 BASE_URL 与 MODEL 即可。
# AGENT_RETRIEVAL_RERANK_API_KEY=
# AGENT_RETRIEVAL_RERANK_BASE_URL=https://api.siliconflow.cn/v1
# AGENT_RETRIEVAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3
