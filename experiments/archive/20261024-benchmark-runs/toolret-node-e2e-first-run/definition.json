{
  "schema_version": 1,
  "flow_id": "toolret-node-chain",
  "flow_version": "1.0.0",
  "description": "add → square → gcd 链式工具调用",
  "input_schema": {
    "type": "object",
    "properties": {
      "a": {
        "type": "integer"
      },
      "b": {
        "type": "integer"
      },
      "modulus": {
        "type": "integer"
      }
    },
    "required": [
      "a",
      "b",
      "modulus"
    ],
    "additionalProperties": false
  },
  "entry": "add_numbers",
  "steps": [
    {
      "id": "add_numbers",
      "description": "计算输入 a 与 b 的和",
      "required": true,
      "inputs": {
        "a": {
          "ref": "flow_input",
          "path": "/a"
        },
        "b": {
          "ref": "flow_input",
          "path": "/b"
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "integer"
          }
        },
        "required": [
          "result"
        ],
        "additionalProperties": false
      },
      "type": "tool",
      "tool": {
        "id": "toolret-add-toolink-tool-43",
        "version": "1.0.0"
      }
    },
    {
      "id": "square_sum",
      "description": "对 add 的实际结果求平方",
      "required": true,
      "inputs": {
        "number": {
          "ref": "step_output",
          "step": "add_numbers",
          "path": "/result"
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "integer"
          }
        },
        "required": [
          "result"
        ],
        "additionalProperties": false
      },
      "type": "tool",
      "tool": {
        "id": "toolret-square-toolink-tool-226",
        "version": "1.0.0"
      }
    },
    {
      "id": "gcd_result",
      "description": "对平方结果与 modulus 求最大公约数",
      "required": true,
      "inputs": {
        "a": {
          "ref": "step_output",
          "step": "square_sum",
          "path": "/result"
        },
        "b": {
          "ref": "flow_input",
          "path": "/modulus"
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "integer"
          }
        },
        "required": [
          "result"
        ],
        "additionalProperties": false
      },
      "type": "tool",
      "tool": {
        "id": "toolret-gcd-toolink-tool-587",
        "version": "1.0.0"
      }
    }
  ],
  "transitions": [
    {
      "type": "next",
      "id": "t1",
      "from": "add_numbers",
      "to": "square_sum"
    },
    {
      "type": "next",
      "id": "t2",
      "from": "square_sum",
      "to": "gcd_result"
    }
  ],
  "output_schema": {
    "type": "object",
    "properties": {
      "result": {
        "type": "integer"
      }
    },
    "required": [
      "result"
    ],
    "additionalProperties": false
  },
  "outputs": {
    "result": {
      "ref": "step_output",
      "step": "gcd_result",
      "path": "/result"
    }
  }
}
