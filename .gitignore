__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.venv/
.staging_*
experiments/*-result.json
# Benchmark datasets and vector caches (downloaded, reproducible via the adapters)
experiments/benchmarks/data/
experiments/benchmarks/.cache/
# Secrets (benchmark embedder credentials et al.)
.env
# Benchmark reports (regenerable via the runners; datasets/caches already ignored)
experiments/*-benchmark*.json
experiments/*-smoke.json
# Jev 实验报告（regenerable via experiments.benchmarks.jev_rerank；jev_cases.json 已跟踪不受影响）
experiments/jev-*.json
experiments/jev-rerank-run.log
# 实验运行日志（iterative-run.log、recall-ablation-run.log 等）
experiments/*-run.log
# 本地工具状态：codegraph 索引与守护进程、Claude 本地配置与临时工作树、skills 安装目录（skills-lock.json 为锁文件，入库）
.codegraph/
.claude/
.agents/
# Paired rerank-arm reports (regenerable via experiments.benchmarks.rerank_paired)
experiments/rerank-*.json
# Recall ablation reports (regenerable via --retriever fields)
experiments/recall-ablation-*.json
# Iterative retrieval reports
experiments/iterative-*.json
# Two-tier retrieval ablation reports (regenerable via experiments.benchmarks.two_tier)
experiments/two-tier-*.json

# 嵌入配对实验报告（可经 embedding_paired 复现）
experiments/emb-paired-*.json
